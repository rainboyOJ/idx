- const initialFor = (value) => Array.from(String(value || "?"))[0]?.toLocaleUpperCase("zh-CN") || "?"
- const normalize = (value) => String(value || "").normalize("NFKC").toLocaleLowerCase("zh-CN").trim()
- const getHostname = (value) => { try { return new URL(value).hostname.replace(/^www\./, "") } catch { return value } }

mixin categoryIcon(group)
  span.category-icon(aria-hidden="true")!= uiIcons[categoryIcons[group.title] || "globe"]

mixin category(group)
  li
    a.category-link(href=`#group-${group.id}` data-group-id=String(group.id))
      +categoryIcon(group)
      span.category-title= group.title
      span.category-count(data-total=group.items.length)= group.items.length

mixin linkIcon(item)
  span.link-icon-frame
    if item.icon
      img.link-icon(src=item.icon alt="" width="40" height="40" loading="lazy" decoding="async")
      span.link-icon-fallback(hidden style=item.iconBackground ? `background-color: ${item.iconBackground}` : undefined)= item.iconText || initialFor(item.title)
    else
      span.link-icon-fallback(style=item.iconBackground ? `background-color: ${item.iconBackground}` : undefined)= item.iconText || initialFor(item.title)

mixin linkCard(item, group)
  - const host = getHostname(item.url)
  a.link-card(href=item.url target="_blank" rel="noopener noreferrer"
    data-search-title=item.title
    data-search-description=item.description || ""
    data-search-domain=host
    data-search-category=group.title)
    +linkIcon(item)
    span.link-copy
      span.link-title= item.title
      span.link-description= item.description || host
      if item.description && normalize(item.description) !== normalize(host)
        span.link-host= host
      span.sr-only （在新标签页打开）
    span.link-external(aria-hidden="true")!= uiIcons["external-link"]

mixin directorySection(group)
  section.directory-section(id=`group-${group.id}` data-group-id=String(group.id))
    .section-heading-row
      h2.section-heading
        span.section-icon(aria-hidden="true")!= uiIcons[categoryIcons[group.title] || "globe"]
        span.section-title= group.title
      span.section-count(data-total=group.items.length)= group.items.length
      span.section-rule(aria-hidden="true")
    .link-grid
      each item in group.items
        +linkCard(item, group)

// 此文件由 config.yaml 和 index.pug 生成，请勿直接修改 index.html。
doctype html
html(lang="zh-CN")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="description" content=site.metaDescription)
    meta(name="color-scheme" content="light dark")
    title= site.title
    link(rel="icon" href="favicon.svg" type="image/svg+xml")
    link(rel="stylesheet" href="styles.css")
    script.
      (() => {
        try {
          const savedTheme = localStorage.getItem("rainboy-nav-theme");
          const systemTheme = matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
          document.documentElement.dataset.theme = savedTheme || systemTheme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    script(src="app.js" defer)
  body
    a.skip-link(href="#main-content") 跳到主要内容

    header#workbar.workbar
      .workbar-inner
        a.brand(href="#top" aria-label=`返回 ${site.title}顶部`)
          span.brand-mark(aria-hidden="true") R
          h1.brand-title= site.title

        .workbar-search
          .search-field(role="search")
            span.search-icon(aria-hidden="true")!= uiIcons.search
            label.sr-only(for="site-search") 搜索网址
            input#site-search(type="search" placeholder="搜索网址" autocomplete="off" spellcheck="false")
            button#search-clear.search-clear(type="button" aria-label="清空搜索" title="清空搜索" hidden)
              span(aria-hidden="true")!= uiIcons.x
          span#result-count.workbar-count #{stats.totalItems} 个网址
          span#search-status.sr-only(role="status" aria-live="polite")

        button#theme-toggle.icon-button(type="button" aria-label="切换到深色主题" title="切换主题")
          span.theme-icon.theme-icon-moon!= uiIcons.moon
          span.theme-icon.theme-icon-sun!= uiIcons.sun

    span#top(aria-hidden="true")

    main#main-content.workbench(tabindex="-1")
      .content-layout
        aside#category-sidebar.category-sidebar(aria-label="网址分类")
          .category-heading
            span 分类
            span#category-total= stats.totalGroups
          nav(aria-label="按分类跳转")
            ul#category-list.category-list
              each group in navigation.groups
                +category(group)

        #directory.directory(aria-busy="false")
          .search-empty#search-empty(hidden)
            span.empty-icon(aria-hidden="true")!= uiIcons.search
            h2.empty-title 没有匹配的网址
            p#empty-query.empty-query
            button#empty-clear.empty-clear(type="button") 清空搜索
          each group in navigation.groups
            +directorySection(group)

    footer.site-footer
      p#footer-summary #{site.title} · 数据更新于 #{navigation.updatedAt}

    button#back-to-top.back-to-top(type="button" aria-label="返回顶部" title="返回顶部" hidden)
      span!= uiIcons["arrow-up"]
